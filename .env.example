DATABASE_URL=postgres://drivechronik:drivechronik@localhost:5432/drivechronik
TESLAMATE_DATABASE_URL=postgres://teslamate:teslamate@localhost:5433/teslamate
APP_TIMEZONE=Europe/Zurich
SYNC_INTERVAL_SECONDS=60
# INITIAL_ADMIN_PASSWORD=

# --- Produktion (docker-compose.yml) -----------------------------------

# Veröffentlichtes Container-Image. "latest" ist der einfache Standard.
# Alternativ kann eine feste Version gepinnt werden, z. B. v0.4.3.
DRIVECHRONIK_IMAGE_TAG=latest
# Passwort für die drivechronik-Postgres im Compose-Stack. Pflichtfeld, kein
# Default — Compose bricht ohne gesetzten Wert ab.
POSTGRES_PASSWORD=

# Port, unter dem die Web-App auf dem Host erreichbar ist (z. B. hinter
# Tailscale serve). Intern läuft der Container immer auf 3000.
WEB_PORT=3000

# In Produktion: read-only-Rolle auf der bestehenden TeslaMate-DB verwenden,
# siehe README "Deployment" für das CREATE ROLE-Statement. Host entweder
# LAN/Tailscale-Adresse oder, falls TeslaMate im selben Compose-Netz läuft,
# der Service-Name (siehe Kommentare in docker-compose.yml).
# TESLAMATE_DATABASE_URL=postgres://drivechronik_ro:...@teslamate-host:5432/teslamate

# Nur relevant, wenn TeslaMate auf demselben Docker-Host läuft und
# docker-compose.teslamate.yml als docker-compose.override.yml verwendet wird.
# TESLAMATE_DOCKER_NETWORK=teslamate_default

# Routenplaner: eigener OSRM-Server statt des öffentlichen Demo-Servers
# (https://project-osrm.org — der Demo-Server ist nicht für Dauerlast gedacht).
# OSRM_URL=https://router.project-osrm.org

# --- Backup -------------------------------------------------------------
# Host-Verzeichnis für DriveChronik-Backups. Es liegt bewusst außerhalb
# des PostgreSQL-Datenvolumes.
BACKUP_DIR=./backups

# Automatisches Backup alle 24 Stunden.
BACKUP_INTERVAL_HOURS=24

# Backups nach 30 Tagen automatisch löschen.
BACKUP_RETENTION_DAYS=30
