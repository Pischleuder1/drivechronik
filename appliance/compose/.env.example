# DriveChronik Raspberry Pi Appliance

APP_TIMEZONE=Europe/Berlin

# Fest gepinnte Anwendungsversionen
TESLAMATE_IMAGE_TAG=4.2.0
DRIVECHRONIK_IMAGE_TAG=v0.4.4

# Weboberflächen
TESLAMATE_PORT=4000
WEB_PORT=3000

# Synchronisierung
SYNC_INTERVAL_SECONDS=60

# Diese Werte werden später beim ersten Boot automatisch erzeugt.
TESLAMATE_POSTGRES_PASSWORD=
TESLAMATE_ENCRYPTION_KEY=
DRIVECHRONIK_TESLAMATE_RO_PASSWORD=
DRIVECHRONIK_POSTGRES_PASSWORD=
DRIVECHRONIK_INITIAL_ADMIN_PASSWORD=
